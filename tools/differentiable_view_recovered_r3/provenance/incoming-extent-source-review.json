  "extraction_custody_sha256": "c2714ca39dc0d68199ce35dce247c162e22e1be132bf8ae5405a2a412d5902e0",
  "facts": [
    {
      "blocks": "b26-b35",
      "finding": "Live Storage requires rounded == so_align16(requested), offset aligned16, extent inside pool, and offset0 if rounded0. Changing requested alone while retaining a larger aligned reservation violates the actual native audit.",
      "function": "so_audit_references",
      "sha256": "14f86e477b6bcd416f9b2084b0942b3d3a283a2ba96913e183cf435c7c636fc7"
    },
    {
      "finding": "Kind6 +24 is private flag1. Storage.requested must exactly equal the function length argument; there is no independent Hold length field.",
      "function": "private_hold",
      "sha256": "3f0c4adaf775e3b51ddcfc31612d47f3915b61e5ca7f103834f006fa5d63ed04"
    },
    {
      "finding": "Alloc records exact requested and align16(requested), a private Hold and Storage strong1/implicitweak1. The new trim keeps the same Storage/Version identities and returns the aligned unused tail before changing the precise extent.",
      "function": "alloc"
    },
    {
      "finding": "Checks active rounded intervals against other active intervals and free intervals. Requested/rounded equality is enforced in so_audit_references, not here.",
      "function": "so_audit_extent",
      "sha256": "042ef15826af085a2dd671bc10c2c898a25278a807b7dc1e2bcf7fff9ea1e036"
    },
    {
      "finding": "Sum of actual rounded Storage extents plus free extents must equal the pool bytes. A capacity label cannot substitute for returning the tail.",
      "function": "so_audit_extents",
      "sha256": "7eb27cbde739f873ee913915e6fa1fd56420dba1ea066d3a49debd36927f4e4f"
    },
    {
      "finding": "Checks live typed token plus strong/weak/dead; does not itself constrain requested or rounded.",
      "function": "so_storage_live",
      "sha256": "7db4e501d11f7bde8e2ba2b5960bb0c47365b48eaf35bb3781ab80feaac978d7"
    },
    {
      "finding": "Calls incoming_construct only when parent+336 is0. Later incoming paths either accumulate through incoming_address and bump the existing Version or bind the preexisting contiguous scratch. They do not reconstruct and trim the used preserve cache.",
      "function": "incoming_merge_edge"
    },
    {
      "finding": "Releases p+552 Hold and p+568 Version, then clears544..568; does not call private_hold(length), so cleanup does not require the old reservation requested byte count.",
      "function": "incoming_drop_cache"
    },
    {
      "finding": "Uses existing contiguous scratch p+256/p+536 and Version p+480; it does not use the new preserve cache p+552/p+560/p+568.",
      "function": "to_zero_factory_incoming",
      "sha256": "3772036d10c16598521b7252d4a9f212cfd62d9c37a993793c00c546160f245a"
    }
  ],
  "guarded_scope": [
    "New nonempty op44 construction rejects an empty input/output and consequently requires at least one float32 byte span. If the trim helper is later called with requested0 from a previously nonzero extent, it must also preserve the native offset0 rule.",
    "Existing valid geometry and shared-offset bounds are prerequisites; this source-only review does not newly establish all reachable huge-stride geometry admission.",
    "The proposed preflight extends preserve allocation capacity. Failure/recovery, row exhaustion, actual branch behavior and exact new four-reference outcomes still require the producer's independently recorded native runs.",
    "No native audit, old numerical predicate, legacy result, test expectation, or production source was changed by this review."
  ],
