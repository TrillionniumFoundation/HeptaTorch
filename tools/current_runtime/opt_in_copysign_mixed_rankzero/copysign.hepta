fn opt_in_copysign_mixed(s:mutbuf,x:u64,z:u64) -> (u64) effects(read,write,trap) entry(admit)
block admit(s:mutbuf,x:u64,z:u64)
  dx:u64 = call(s,x) {"function":"tensor_dtype"}
  dz:u64 = call(s,z) {"function":"tensor_dtype"}
  f64:u64 = const() {"value":4}
  dx_ok:bool = compare.eq(dx,f64)
  dz_ok:bool = compare.eq(dz,f64)
  z0:u64 = const() {"value":0}
  dx0:bool = compare.eq(dx,z0)
  dz0:bool = compare.eq(dz,z0)
  mixed1:bool = bool.and(dx_ok,dz0)
  mixed2:bool = bool.and(dx0,dz_ok)
  d_ok:bool = bool.or(mixed1,mixed2)
  branch d_ok grads(s,x,z) type_error(s)
block type_error(sdtype:mutbuf)
  codee:u64 = const() {"value":4}
  erre:u64 = call(sdtype,codee) {"function":"terror"}
  ret(erre)
block grads(sg:mutbuf,xg:u64,zg:u64)
  pg:u64 = call(sg,xg) {"function":"dptr"}
  qg:u64 = call(sg,zg) {"function":"dptr"}
  grad_at:u64 = const() {"value":32}
  gp:u64 = int.add.wrap(pg,grad_at)
  gq:u64 = int.add.wrap(qg,grad_at)
  xp:u64 = call(sg,gp) {"function":"getw"}
  zp:u64 = call(sg,gq) {"function":"getw"}
  any_grad:u64 = bit.or(xp,zp)
  zerog:u64 = const() {"value":0}
  grad_ok:bool = compare.eq(any_grad,zerog)
  branch grad_ok geometry(sg,xg,zg,pg,qg) no_ad(sg)
block no_ad(sf:mutbuf)
  codef:u64 = const() {"value":5}
  errf:u64 = call(sf,codef) {"function":"terror"}
  ret(errf)
block geometry(st:mutbuf,xt:u64,zt:u64,pt:u64,qt:u64)
  offset_at:u64 = const() {"value":232}
  op:u64 = int.add.wrap(pt,offset_at)
  oq:u64 = int.add.wrap(qt,offset_at)
  ox:u64 = call(st,op) {"function":"getw"}
  oz:u64 = call(st,oq) {"function":"getw"}
  offsets:u64 = bit.or(ox,oz)
  cx:u64 = call(st,xt) {"function":"is_contiguous"}
  cz:u64 = call(st,zt) {"function":"is_contiguous"}
  rankt:u64 = call(st,pt) {"function":"getw"}
  rankzt:u64 = call(st,qt) {"function":"getw"}
  zerot:u64 = const() {"value":0}
  onet:u64 = const() {"value":1}
  fourt:u64 = const() {"value":4}
  offset_ok:bool = compare.eq(offsets,zerot)
  rankx_ok:bool = compare.le(rankt,fourt)
  rankz_ok:bool = compare.le(rankzt,fourt)
  rank_ok:bool = bool.and(rankx_ok,rankz_ok)
  contig:u64 = bit.and(cx,cz)
  layout_ok:bool = compare.eq(contig,onet)
  geom_ok:bool = bool.and(offset_ok,layout_ok)
  admitted:bool = bool.and(rank_ok,geom_ok)
  branch admitted shape(st,xt,zt) unsupported(st)
block unsupported(su:mutbuf)
  codeu:u64 = const() {"value":7}
  erru:u64 = call(su,codeu) {"function":"terror"}
  ret(erru)
block shape(sb:mutbuf,xb:u64,zb:u64)
  rankb:u64 = call(sb,xb,zb) {"function":"bshape"}
  zerob:u64 = const() {"value":0}
  errorb:u64 = call(sb,zerob) {"function":"getw"}
  badb:bool = compare.ne(errorb,zerob)
  branch badb failure() dtype(sb,xb,zb,rankb)
block dtype(sd:mutbuf,xd:u64,zd:u64,rd:u64)
  zero_d:u64 = const() {"value":0}
  dx_d:u64 = call(sd,xd) {"function":"tensor_dtype"}
  mag32_d:bool = compare.eq(dx_d,zero_d)
  lead32_d:u64 = select(mag32_d,xd,zd)
  lead64_d:u64 = select(mag32_d,zd,xd)
  p32_d:u64 = call(sd,lead32_d) {"function":"dptr"}
  p64_d:u64 = call(sd,lead64_d) {"function":"dptr"}
  r32_d:u64 = call(sd,p32_d) {"function":"getw"}
  r64_d:u64 = call(sd,p64_d) {"function":"getw"}
  nd_d:bool = compare.ne(r32_d,zero_d)
  sz_d:bool = compare.eq(r64_d,zero_d)
  out32_d:bool = bool.and(nd_d,sz_d)
  branch out32_d allocate32(sd,xd,zd,rd) allocate(sd,xd,zd,rd)
block allocate32(sa3:mutbuf,xa3:u64,za3:u64,ra3:u64)
  shape3:u64 = const() {"value":128}
  zero3:u64 = const() {"value":0}
  y3:u64 = call(sa3,ra3,shape3,zero3) {"function":"tnew"}
  bad3:bool = compare.eq(y3,zero3)
  branch bad3 failure() start(sa3,xa3,za3,y3)
block allocate(sa:mutbuf,xa:u64,za:u64,ranka:u64)
  shape:u64 = const() {"value":128}
  zeroa:u64 = const() {"value":0}
  leafa:u64 = const() {"value":1}
  dtypea:u64 = const() {"value":4}
  y:u64 = call(sa,ranka,shape,zeroa,leafa,dtypea) {"function":"typed_descriptor"}
  failed:bool = compare.eq(y,zeroa)
  branch failed failure() start(sa,xa,za,y)
block failure()
  zerof:u64 = const() {"value":0}
  ret(zerof)
block start(ss:mutbuf,xs:u64,zs:u64,ys:u64)
  ps:u64 = call(ss,ys) {"function":"dptr"}
  count_at:u64 = const() {"value":8}
  count_ptr:u64 = int.add.wrap(ps,count_at)
  count:u64 = call(ss,count_ptr) {"function":"getw"}
  zeros:u64 = const() {"value":0}
  xds:u64 = call(ss,xs) {"function":"tensor_dtype"}
  mag_f32:bool = compare.eq(xds,zeros)
  jump loop(ss,xs,zs,ys,count,zeros,mag_f32)
block loop(sl:mutbuf,xl:u64,zl:u64,yl:u64,nl:u64,il:u64,ml:bool)
  more:bool = compare.lt(il,nl)
  branch more element(sl,xl,zl,yl,nl,il,ml) done(yl)
block element(se:mutbuf,xe:u64,ze:u64,ye:u64,ne:u64,ie:u64,me:bool)
  xi:u64 = call(se,ye,xe,ie) {"function":"bindex"}
  zi:u64 = call(se,ye,ze,ie) {"function":"bindex"}
  xword:u64 = call(se,xe,xi) {"function":"tget"}
  zword:u64 = call(se,ze,zi) {"function":"tget"}
  de:u64 = call(se,ye) {"function":"tensor_dtype"}
  ze0:u64 = const() {"value":0}
  out32_e:bool = compare.eq(de,ze0)
  branch out32_e select32(se,ye,ne,ie,xe,ze,xword,zword,me) select64(se,ye,ne,ie,xe,ze,xword,zword,me)
block select32(st3:mutbuf,yt3:u64,nt3:u64,it3:u64,xt3:u64,zt3:u64,wxt3:u64,wzt3:u64,mt3:bool)
  branch mt3 sign32(st3,yt3,nt3,it3,xt3,zt3,wxt3,wzt3,mt3) magnitude32(st3,yt3,nt3,it3,xt3,zt3,wxt3,wzt3,mt3)
block sign32(ss3:mutbuf,ys3:u64,ns3:u64,is3:u64,xs3:u64,zs3:u64,wxs3:u64,wzs3:u64,ms3:bool)
  sh3:u64 = const() {"value":32}
  relocated3:u64 = int.shr.checked(wzs3,sh3)
  jump store32(ss3,ys3,ns3,is3,xs3,zs3,wxs3,relocated3,ms3)
block magnitude32(sm3:mutbuf,ym3:u64,nm3:u64,im3:u64,xm3:u64,zm3:u64,wxm3:u64,wzm3:u64,mm3:bool)
  narrowed3:u64 = call(wxm3) {"function":"narrow64"}
  absmask3:u64 = const() {"value":2147483647}
  abs3:u64 = bit.and(narrowed3,absmask3)
  qnan3:u64 = const() {"value":2143289344}
  isnan3:bool = compare.eq(abs3,qnan3)
  payload_sh3:u64 = const() {"value":29}
  payload_raw3:u64 = int.shr.checked(wxm3,payload_sh3)
  payload_mask3:u64 = const() {"value":4194303}
  payload3:u64 = bit.and(payload_raw3,payload_mask3)
  exact3:u64 = bit.or(narrowed3,payload3)
  out3:u64 = select(isnan3,exact3,narrowed3)
  jump store32(sm3,ym3,nm3,im3,xm3,zm3,out3,wzm3,mm3)
block store32(sw3:mutbuf,yw3:u64,nw3:u64,iw3:u64,xw3:u64,zw3:u64,wwx3:u64,wwz3:u64,mw3:bool)
  magmask3:u64 = const() {"value":2147483647}
  signmask3:u64 = const() {"value":2147483648}
  mmw3:u64 = bit.and(wwx3,magmask3)
  ssw3:u64 = bit.and(wwz3,signmask3)
  value3:u64 = bit.or(mmw3,ssw3)
  addr3:u64 = call(sw3,yw3,iw3) {"function":"taddr"}
  stored3:u64 = call(sw3,addr3,value3) {"function":"put4"}
  one3:u64 = const() {"value":1}
  next3:u64 = int.add.wrap(iw3,one3)
  jump loop(sw3,xw3,zw3,yw3,nw3,next3,mw3)
block select64(st6:mutbuf,yt6:u64,nt6:u64,it6:u64,xt6:u64,zt6:u64,wxt6:u64,wzt6:u64,mt6:bool)
  branch mt6 convert_mag(st6,yt6,nt6,it6,xt6,zt6,wxt6,wzt6,mt6) convert_sign(st6,yt6,nt6,it6,xt6,zt6,wxt6,wzt6,mt6)
block convert_mag(sm:mutbuf,ym:u64,nm:u64,im:u64,xm:u64,zm:u64,wxm:u64,wzm:u64,mm:bool)
  widened:u64 = call(wxm) {"function":"widen32"}
  jump store(sm,ym,nm,im,xm,zm,widened,wzm,mm)
block convert_sign(ssi:mutbuf,ysi:u64,nsi:u64,isi:u64,xsi:u64,zsi:u64,wxsi:u64,wzsi:u64,msi:bool)
  shift:u64 = const() {"value":32}
  expanded:u64 = int.shl.checked(wzsi,shift)
  jump store(ssi,ysi,nsi,isi,xsi,zsi,wxsi,expanded,msi)
block store(sw:mutbuf,yw:u64,nw:u64,iw:u64,xw:u64,zw:u64,wwx:u64,wwz:u64,mw:bool)
  magnitude_mask:u64 = const() {"value":9223372036854775807}
  sign_mask:u64 = const() {"value":9223372036854775808}
  magnitude:u64 = bit.and(wwx,magnitude_mask)
  sign:u64 = bit.and(wwz,sign_mask)
  value:u64 = bit.or(magnitude,sign)
  address:u64 = call(sw,yw,iw) {"function":"taddr"}
  width:u64 = const() {"value":8}
  stored:u64 = call(sw,address,width,value) {"function":"typed_store"}
  onee:u64 = const() {"value":1}
  next:u64 = int.add.wrap(iw,onee)
  jump loop(sw,xw,zw,yw,nw,next,mw)
block done(yd:u64)
  ret(yd)
end
