  alias:u64 = call(sfin,nfin,nrank,df,stf,alias_mode) {"function":"shape_alias"}
  zero_f:u64 = const() {"value":0}
  clear_width:u64 = const() {"value":64}
  scrub:u64 = call(sfin,df,clear_width,zero_f) {"function":"memory_fill"}
