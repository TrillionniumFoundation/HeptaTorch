  size_put:u64 = call(sf,size_at,zf) {"function":"putw"}
  stride_put:u64 = call(sf,stride_at,tf) {"function":"putw"}
  one_f:u64 = const() {"value":1}
  next_o:u64 = int.add.wrap(of,one_f)
  jump loop(sf,nf,pf,rf,rrf,af,next_o,inf)
block finish(sfin:mutbuf,nfin:u64,nrank:u64)
  df:u64 = const() {"value":2048}
  stf:u64 = const() {"value":2080}
