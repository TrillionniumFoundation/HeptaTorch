  jump set_axis(sk,nk,pk,rk,rrk,ak,ok,ik,single,stride)
block copy(sc:mutbuf,nc:u64,pc:u64,rc:u64,rrc:u64,ac:u64,oc:u64,ic:u64)
  dim_field_c:u64 = const() {"value":96}
