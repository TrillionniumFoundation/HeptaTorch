end
fn opt_in_unsqueeze_geometry(s:mutbuf,p:u64,i:u64,field:u64) -> (u64) effects(read,write,trap) entry(start)
block start(s:mutbuf,p:u64,i:u64,field:u64)
  eight:u64 = const() {"value":8}
  step:u64 = int.mul.wrap(i,eight)
  local:u64 = int.add.wrap(p,step)
  at:u64 = int.add.wrap(local,field)
  value:u64 = call(s,at) {"function":"getw"}
  ret(value)
end
