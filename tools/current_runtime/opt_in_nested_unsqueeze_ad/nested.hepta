block grad_kind(ns0_sad:mutbuf,ns0_nad:u64,ns0_dad:u64,ns0_pad:u64,ns0_rad:u64,ns0_kind:u64,ns0_view_kind:u64)
  ns0_g0:u64 = const() {"value":0}
  ns0_scope_full:u64 = bit.or(ns0_kind,ns0_view_kind)
  ns0_ordinary_leaf:bool = compare.eq(ns0_scope_full,ns0_g0)
  branch ns0_ordinary_leaf wrap(ns0_sad,ns0_nad,ns0_dad,ns0_pad,ns0_rad) prior_kind(ns0_sad,ns0_nad,ns0_dad,ns0_pad,ns0_rad,ns0_kind,ns0_view_kind)
block prior_kind(ns1_sp:mutbuf,ns1_np:u64,ns1_dp:u64,ns1_pp:u64,ns1_rp:u64,ns1_kp:u64,ns1_vp:u64)
  ns1_s45:u64 = const() {"value":45}
  ns1_s1:u64 = const() {"value":1}
  ns1_reshape_edge:bool = compare.eq(ns1_kp,ns1_s45)
  ns1_ordinary_view:bool = compare.eq(ns1_vp,ns1_s1)
  ns1_one_prior:bool = bool.and(ns1_reshape_edge,ns1_ordinary_view)
  branch ns1_one_prior prior_leaf(ns1_sp,ns1_np,ns1_dp,ns1_pp,ns1_rp) grad_error(ns1_sp)
block prior_leaf(ns2_sl2:mutbuf,ns2_nl2:u64,ns2_dl2:u64,ns2_pl2:u64,ns2_rl2:u64)
  ns2_n0:u64 = const() {"value":0}
