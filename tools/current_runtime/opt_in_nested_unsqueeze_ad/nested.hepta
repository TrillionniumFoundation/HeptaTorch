  ns2_valid:bool = compare.ne(ns2_base,ns2_n0)
  branch ns2_valid differentiable_leaf(ns2_sl2,ns2_nl2,ns2_dl2,ns2_pl2,ns2_rl2,ns2_base) grad_error(ns2_sl2)
block differentiable_leaf(ns3_sb:mutbuf,ns3_nb:u64,ns3_db:u64,ns3_pb:u64,ns3_rb:u64,ns3_bb:u64)
  ns3_base_desc:u64 = call(ns3_sb,ns3_bb) {"function":"dptr"}
  ns3_base_rank:u64 = call(ns3_sb,ns3_base_desc) {"function":"getw"}
  ns3_one_b:u64 = const() {"value":1}
  ns3_lifted_rank:u64 = int.add.wrap(ns3_base_rank,ns3_one_b)
  ns3_rank_ok:bool = compare.eq(ns3_lifted_rank,ns3_rb)
  ns3_eight_b:u64 = const() {"value":8}
  ns3_bc_at:u64 = int.add.wrap(ns3_base_desc,ns3_eight_b)
  ns3_nc_at:u64 = int.add.wrap(ns3_pb,ns3_eight_b)
  ns3_bc:u64 = call(ns3_sb,ns3_bc_at) {"function":"getw"}
  ns3_nc:u64 = call(ns3_sb,ns3_nc_at) {"function":"getw"}
  ns3_count_ok:bool = compare.eq(ns3_bc,ns3_nc)
  ns3_forty_b:u64 = const() {"value":40}
  ns3_bk_at:u64 = int.add.wrap(ns3_base_desc,ns3_forty_b)
  ns3_bk:u64 = call(ns3_sb,ns3_bk_at) {"function":"getw"}
  ns3_view_b:u64 = const() {"value":408}
  ns3_bv_at:u64 = int.add.wrap(ns3_base_desc,ns3_view_b)
  ns3_bv:u64 = call(ns3_sb,ns3_bv_at) {"function":"getw"}
  ns3_off_b:u64 = const() {"value":232}
  ns3_bo_at:u64 = int.add.wrap(ns3_base_desc,ns3_off_b)
  ns3_bo:u64 = call(ns3_sb,ns3_bo_at) {"function":"getw"}
  ns3_bcont:u64 = call(ns3_sb,ns3_bb) {"function":"is_contiguous"}
  ns3_b0:u64 = const() {"value":0}
  ns3_bflags_a:u64 = bit.or(ns3_bk,ns3_bv)
  ns3_bflags_b:u64 = bit.or(ns3_bflags_a,ns3_bo)
  ns3_base_leaf:bool = compare.eq(ns3_bflags_b,ns3_b0)
  ns3_base_dense:bool = compare.eq(ns3_bcont,ns3_one_b)
  ns3_storage_b:u64 = const() {"value":216}
  ns3_version_b:u64 = const() {"value":224}
  ns3_bs_at:u64 = int.add.wrap(ns3_base_desc,ns3_storage_b)
  ns3_ns_at:u64 = int.add.wrap(ns3_pb,ns3_storage_b)
  ns3_bs:u64 = call(ns3_sb,ns3_bs_at) {"function":"getw"}
  ns3_ns:u64 = call(ns3_sb,ns3_ns_at) {"function":"getw"}
  ns3_bver_at:u64 = int.add.wrap(ns3_base_desc,ns3_version_b)
  ns3_nver_at:u64 = int.add.wrap(ns3_pb,ns3_version_b)
  ns3_bver:u64 = call(ns3_sb,ns3_bver_at) {"function":"getw"}
  ns3_nver:u64 = call(ns3_sb,ns3_nver_at) {"function":"getw"}
  ns3_storage_ok:bool = compare.eq(ns3_bs,ns3_ns)
  ns3_version_ok:bool = compare.eq(ns3_bver,ns3_nver)
  ns3_ids_ok:bool = bool.and(ns3_storage_ok,ns3_version_ok)
  ns3_geom_ok:bool = bool.and(ns3_rank_ok,ns3_count_ok)
  ns3_base_ok:bool = bool.and(ns3_base_leaf,ns3_base_dense)
  ns3_pass_a:bool = bool.and(ns3_geom_ok,ns3_base_ok)
  ns3_pass_b:bool = bool.and(ns3_pass_a,ns3_ids_ok)
  branch ns3_pass_b wrap(ns3_sb,ns3_nb,ns3_db,ns3_pb,ns3_rb) grad_error(ns3_sb)
