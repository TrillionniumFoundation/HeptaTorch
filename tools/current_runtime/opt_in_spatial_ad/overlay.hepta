fn unary(s:mutbuf,operation:u64,input:u64) -> (u64) effects(read,write,trap) entry(start)
block start(s:mutbuf,operation:u64,input:u64)
  valid:u64 = call(s,input) {"function":"valid"}
  zero:u64 = const() {"value":0}
  failed:bool = compare.eq(valid,zero)
  branch failed failure() square_route(s,operation,input)
block square_route(sq:mutbuf,oq:u64,xq:u64)
  dtypeq:u64 = call(sq,xq) {"function":"tensor_dtype"}
  f32q:u64 = const() {"value":0}
  squareq:u64 = const() {"value":16}
  typeq:bool = compare.eq(dtypeq,f32q)
  opq:bool = compare.eq(oq,squareq)
  admitsq:bool = bool.and(typeq,opq)
  branch admitsq square_native(sq,xq) route(sq,oq,xq)
block square_native(ssq:mutbuf,xsq:u64)
  ysq:u64 = call(ssq,xsq) {"function":"opt_in_square_f32"}
  ret(ysq)
block failure()
  zero1:u64 = const() {"value":0}
  ret(zero1)
block route(sr:mutbuf,opr:u64,xr:u64)
  dr:u64 = call(sr,xr) {"function":"tensor_dtype"}
  two_r:u64 = const() {"value":2}
  four_r:u64 = const() {"value":4}
  five_r:u64 = const() {"value":5}
  six_r:u64 = const() {"value":6}
  i64_r:bool = compare.eq(dr,two_r)
  f64_r:bool = compare.eq(dr,four_r)
  f16_r:bool = compare.eq(dr,five_r)
  bf16_r:bool = compare.eq(dr,six_r)
  wide_r:bool = bool.or(i64_r,f64_r)
  half_r:bool = bool.or(f16_r,bf16_r)
  typed_r:bool = bool.or(wide_r,half_r)
  relu_r:bool = compare.eq(opr,five_r)
  admitted_r:bool = bool.and(typed_r,relu_r)
  branch admitted_r native_relu(sr,opr,xr) previous_route(sr,opr,xr)
block native_relu(sn:mutbuf,opn:u64,xn:u64)
  yn:u64 = call(sn,opn,xn) {"function":"typed_relu_tensor"}
  ret(yn)
block previous_route(s2:mutbuf,o2:u64,x2:u64)
  dtype2:u64 = call(s2,x2) {"function":"tensor_dtype"}
  i64_dtype2:u64 = const() {"value":2}
  f64_dtype2:u64 = const() {"value":4}
  is_i64_2:bool = compare.eq(dtype2,i64_dtype2)
  is_f64_2:bool = compare.eq(dtype2,f64_dtype2)
  wide2:bool = bool.or(is_i64_2,is_f64_2)
  branch wide2 negative(s2,o2,x2) previous(s2,o2,x2)
block negative(s3:mutbuf,o3:u64,x3:u64)
  y3:u64 = call(s3,o3,x3) {"function":"wide_neg_tensor"}
  ret(y3)
block previous(s4:mutbuf,o4:u64,x4:u64)
  y4:u64 = call(s4,o4,x4) {"function":"wide_neg_previous_unary"}
  ret(y4)
end
