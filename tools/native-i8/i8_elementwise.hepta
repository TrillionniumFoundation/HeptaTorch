  b0_pos2:u64 = int.add.wrap(offset,b0_byteoff2)
  b0_at2:usize = int.cast(b0_pos2) {"mode":"wrap"}
  b0_octet2:u8 = buffer.load(input,b0_at2)
  b0_piece2:u64 = int.cast(b0_octet2) {"mode":"wrap"}
  b0_shifted2:u64 = int.shl.checked(b0_piece2,b0_shift2)
  b0_accum3:u64 = bit.or(b0_accum2,b0_shifted2)
  b0_shift3:u64 = const() {"value":24}
  b0_byteoff3:u64 = const() {"value":3}
  b0_pos3:u64 = int.add.wrap(offset,b0_byteoff3)
  b0_at3:usize = int.cast(b0_pos3) {"mode":"wrap"}
  b0_octet3:u8 = buffer.load(input,b0_at3)
  b0_piece3:u64 = int.cast(b0_octet3) {"mode":"wrap"}
  b0_shifted3:u64 = int.shl.checked(b0_piece3,b0_shift3)
