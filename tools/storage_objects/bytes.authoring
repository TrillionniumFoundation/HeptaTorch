def rget(s:readbuf, at:u64) -> u64:
    value = 0
    i = 0
    while i < 8:
        value = value | (byte(s,at+i) << (i*8))
        i = i + 1
    return value

def uget(w:mutbuf, at:u64) -> u64:
    value = 0
    i = 0
    while i < 8:
        value = value | (byte(w,at+i) << (i*8))
        i = i + 1
    return value

def uput(w:mutbuf, at:u64, value:u64) -> u64:
    i = 0
    while i < 8:
        store(w,at+i,value >> (i*8))
        i = i + 1
    return 0

def align16(value:u64) -> u64:
    return (value+15) & 18446744073709551600

def slots_normalized(value:u64) -> u64:
    if value > 65536:
        return 0
    n = 4
    while n < value:
        n = n * 2
    return n

def data_base(slots:u64) -> u64:
    return slots*424+144

def state_size(slots:u64, pool:u64) -> u64:
    if slots < 4 or slots > 65536 or pool < 16 or pool > 1073741824:
        return 0
    if (slots & (slots-1)) != 0 or (pool & 15) != 0:
        return 0
    return data_base(slots)+pool

def reply_begin(o:mutbuf) -> u64:
    fill_range(o,0,32,0)
    uput(o,0,RESPONSE_MAGIC)
    uput(o,8,1)
    return 0

def reply_error(o:mutbuf, status:u64) -> u64:
    reply_begin(o)
    uput(o,24,status)
    return 32

def reply_record(o:mutbuf, at:u64, op:u64, a:u64, b:u64, c:u64, d:u64, e:u64, payload:u64) -> u64:
    fill_range(o,at,64,0)
    uput(o,at,op)
    uput(o,at+16,a)
    uput(o,at+24,b)
    uput(o,at+32,c)
    uput(o,at+40,d)
    uput(o,at+48,e)
    uput(o,at+56,payload)
    return 0

def frame_valid(s:readbuf) -> u64:
    if length(s) < 32 or length(s) > 1048576:
        return 100
    if rget(s,0) != REQUEST_MAGIC:
        return 100
    count = rget(s,8)
    if count > 1024 or length(s) != 32+count*64:
        return 100
    return 0

def trace_valid(s:readbuf) -> u64:
    if length(s) < 16 or rget(s,0) != TRACE_REQUEST_MAGIC:
        return 100
    count = rget(s,8)
    if count > 1024:
        return 100
    i = 0
    at = 16
    while i < count:
        if at > length(s) or length(s)-at < 8:
            return 100
        size = rget(s,at)
        at = at + 8
        if size > 1048576 or size > length(s)-at:
            return 100
        at = at + size
        i = i + 1
    if at != length(s):
        return 100
    return 0
