hia-asm.v1 hepta.hia.program.v8 cpu_generator_owners
exports(step,close)
fn cg_apply(p0:readbuf,p1:readbuf,p2:mutbuf,p3:mutbuf,p4:mutbuf,p5:readbuf) -> (u64) effects(read,write,trap) external()
fn cg_mutates(p0:readbuf) -> (u64) effects(read,write,trap) external()
fn cg_payload(p0:readbuf) -> (u64) effects(read,write,trap) external()
fn cg_read(p0:readbuf,p1:readbuf,p2:mutbuf) -> (u64) effects(read,write,trap) external()
fn cg_reply(p0:mutbuf,p1:readbuf,p2:u64,p3:u64) -> (u64) effects(read,write,trap) external()
fn cg_size(p0:readbuf,p1:readbuf) -> (u64) effects(read,write,trap) external()
fn cg_validate(p0:readbuf,p1:readbuf,p2:readbuf,p3:u64) -> (u64) effects(read,write,trap) external()
fn cg_error(state:buffer,o:mutbuf,status:u64) -> (buffer,u32) effects(alloc,read,write,trap) entry(b0)
block b0(state:buffer,o:mutbuf,status:u64)
  r:readbuf = borrow.read(state)
  zero:u64 = const() {"value":0}
  n:u64 = call(o,r,status,zero) {"function":"cg_reply"}
  _ = loan.end(r)
  count:u32 = int.cast(n) {"mode":"wrap"}
  ret(state,count)
end
fn step(s:readbuf,o:mutbuf,state:buffer,e:readbuf) -> (buffer,u32) effects(alloc,read,write,trap) entry(b0)
block b0(s:readbuf,o:mutbuf,state:buffer,e:readbuf)
  cap:usize = buffer.len(o)
  minimum:usize = const() {"value":64}
  short:bool = compare.lt(cap,minimum)
  branch short no_output(state) envelope(s,o,state,e,cap)
block no_output(state1:buffer)
  n1:u32 = const() {"value":0}
  ret(state1,n1)
block envelope(s2:readbuf,o2:mutbuf,state2:buffer,e2:readbuf,cap2:usize)
  source2:readbuf = borrow.read(state2)
  capacity2:u64 = int.cast(cap2) {"mode":"wrap"}
  status2:u64 = call(s2,source2,e2,capacity2) {"function":"cg_validate"}
  _ = loan.end(source2)
  z2:u64 = const() {"value":0}
  good2:bool = compare.eq(status2,z2)
  branch good2 select(s2,o2,state2,e2) failure(o2,state2,status2)
block failure(of:mutbuf,stf:buffer,statusf:u64)
  retainedf:buffer,countf:u32 = call(stf,of,statusf) {"function":"cg_error"}
  ret(retainedf,countf)
block select(s3:readbuf,o3:mutbuf,state3:buffer,e3:readbuf)
  change3:u64 = call(s3) {"function":"cg_mutates"}
  z3:u64 = const() {"value":0}
  mut3:bool = compare.ne(change3,z3)
  branch mut3 allocate(s3,o3,state3,e3) readonly(s3,o3,state3)
block readonly(s4:readbuf,o4:mutbuf,state4:buffer)
  source4:readbuf = borrow.read(state4)
  n4:u64 = call(s4,source4,o4) {"function":"cg_read"}
  _ = loan.end(source4)
  count4:u32 = int.cast(n4) {"mode":"wrap"}
  ret(state4,count4)
block allocate(s5:readbuf,o5:mutbuf,state5:buffer,e5:readbuf)
  source5:readbuf = borrow.read(state5)
  n5:u64 = call(s5,source5) {"function":"cg_size"}
  _ = loan.end(source5)
  amount5:usize = int.cast(n5) {"mode":"wrap"}
  trial5:buffer,ok5:bool = buffer.try_new(amount5)
  branch ok5 scratch(s5,o5,state5,e5,trial5) trial_failed(o5,state5,trial5)
block trial_failed(o6:mutbuf,state6:buffer,trial6:buffer)
  _ = owner.drop(trial6)
  status6:u64 = const() {"value":3}
  jump failure(o6,state6,status6)
block scratch(s7:readbuf,o7:mutbuf,state7:buffer,e7:readbuf,trial7:buffer)
  amount7:usize = const() {"value":5056}
  scratch7:buffer,ok7:bool = buffer.try_new(amount7)
  branch ok7 execute(s7,o7,state7,e7,trial7,scratch7) scratch_failed(o7,state7,trial7,scratch7)
block scratch_failed(o8:mutbuf,state8:buffer,trial8:buffer,scratch8:buffer)
  _ = owner.drop(scratch8)
  _ = owner.drop(trial8)
  status8:u64 = const() {"value":3}
  jump failure(o8,state8,status8)
block execute(s9:readbuf,o9:mutbuf,state9:buffer,e9:readbuf,trial9:buffer,scratch9:buffer)
  source9:readbuf = borrow.read(state9)
  target9:mutbuf = borrow.mut(trial9)
  work9:mutbuf = borrow.mut(scratch9)
  status9:u64 = call(s9,source9,target9,work9,o9,e9) {"function":"cg_apply"}
  _ = loan.end(work9)
  _ = loan.end(target9)
  _ = loan.end(source9)
  _ = owner.drop(scratch9)
  zero9:u64 = const() {"value":0}
  good9:bool = compare.eq(status9,zero9)
  branch good9 commit(s9,o9,state9,trial9) abort(o9,state9,trial9,status9)
block abort(o10:mutbuf,state10:buffer,trial10:buffer,status10:u64)
  _ = owner.drop(trial10)
  jump failure(o10,state10,status10)
block commit(s11:readbuf,o11:mutbuf,state11:buffer,trial11:buffer)
  _ = owner.drop(state11)
  r11:readbuf = borrow.read(trial11)
  p11:u64 = call(s11) {"function":"cg_payload"}
  zero11:u64 = const() {"value":0}
  n11:u64 = call(o11,r11,zero11,p11) {"function":"cg_reply"}
  _ = loan.end(r11)
  count11:u32 = int.cast(n11) {"mode":"wrap"}
  ret(trial11,count11)
end
fn close(state:buffer) -> () effects(alloc,trap) entry(b0)
block b0(state:buffer)
  _ = owner.drop(state)
  ret()
end
