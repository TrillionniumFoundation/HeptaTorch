def cg_state_valid(st:readbuf) -> u64:
    size = length(st)
    if size == 0:
        return 0
    if size < 64 or getr(st,0) != STATE_MAGIC:
        return 10
    count = getr(st,16)
    if count > 1024 or size != 64+count*5088:
        return 10
    if getr(st,32) != 1 or getr(st,40) != 5088 or getr(st,48) != 0 or getr(st,56) != 0:
        return 10
    last = getr(st,8)
    i = 0
    while i < count:
        at = 64+i*5088
        handle = getr(st,at)
        if handle == 0 or handle > last or getr(st,at+8) != 0 or getr(st,at+16) != 0 or getr(st,at+24) != 0:
            return 10
        i = i+1
    return 0

def cg_stat(st:readbuf,at:u64) -> u64:
    if length(st) < 64:
        return 0
    return getr(st,at)

def cg_find(st:readbuf,handle:u64) -> u64:
    count = cg_stat(st,16)
    i = 0
    while i < count:
        at = 64+i*5088
        if getr(st,at) == handle:
            return at
        i = i+1
    return 0

def cg_mutates(s:readbuf) -> u64:
    op = getr(s,8)
    if op == 4 or op == 5 or op == 17 or op == 18:
        return 0
    if op >= 8 and op <= 15 and getr(s,24) == 0:
        return 0
    return 1

def cg_payload(s:readbuf) -> u64:
    op = getr(s,8)
    if op == 1 or op == 7 or op == 19:
        return getr(s,24)*8
    if op == 3 or op == 4:
        return 8
    if op == 5:
        return 5056
    if op >= 9 and op <= 15:
        return getr(s,24)*8
    if op == 18:
        return getr(s,24)
    return 0

def cg_validate(s:readbuf,st:readbuf,e:readbuf,capacity:u64) -> u64:
    if length(s) < 64 or getr(s,0) != REQUEST_MAGIC or getr(s,56) != 0:
        return 1
    payload = getr(s,48)
    if payload > 5056 or length(s) != 64+payload:
        return 1
    op = getr(s,8)
    handle = getr(s,16)
    count = getr(s,24)
    a = getr(s,32)
    b = getr(s,40)
    if op < 1 or op > 19:
        return 5
    if op == 6:
        if payload != 5056:
            return 1
    else:
        if payload != 0:
            return 1
    status = cg_state_valid(st)
    if status != 0:
        return status
    if op == 1 or op == 19:
        if handle != 0 or b != 0 or (op == 19 and a != 0):
            return 1
    else:
        if op == 17 or op == 18:
            if handle != 0:
                return 1
        else:
            if handle == 0 or cg_find(st,handle) == 0:
                return 4
    if op == 1 or op == 7 or op == 19:
        if count == 0 or count > 1024-cg_stat(st,16):
            return 3
        if count > 18446744073709551615-cg_stat(st,8):
            return 8
    else:
        if op < 8 or op == 16 or op == 17:
            if count != 0:
                return 1
    if op != 1 and op != 2 and op != 15 and op != 18:
        if a != 0:
            return 1
    if op != 15 and b != 0:
        return 1
    if op >= 8 and op <= 15:
        if count > 1000000 or (op != 8 and count > 100000):
            return 3
        if op == 15 and (a ^ 9223372036854775808) >= (b ^ 9223372036854775808):
            return 1
        words = count
        if op == 10 or op == 12 or (op == 15 and b-a >= 268435456):
            words = count*2
        if words > 1000000:
            return 3
    if op == 18:
        if count > 1048512 or a > length(st) or count > length(st)-a:
            return 1
    if capacity < 64 or cg_payload(s) > capacity-64:
        return 3
    if op == 3 and length(e) != 8:
        return 9
    if cg_mutates(s) != 0 and cg_stat(st,24) == 18446744073709551615:
        return 8
    return 0

def cg_size(s:readbuf,st:readbuf) -> u64:
    count = cg_stat(st,16)
    op = getr(s,8)
    if op == 1 or op == 7 or op == 19:
        count = count+getr(s,24)
    if op == 16:
        count = count-1
    return 64+count*5088

def cg_reply(o:mutbuf,st:readbuf,status:u64,payload:u64) -> u64:
    putw(o,0,RESPONSE_MAGIC)
    putw(o,8,status)
    putw(o,16,payload)
    putw(o,24,cg_stat(st,16))
    putw(o,32,length(st))
    putw(o,40,cg_stat(st,8))
    putw(o,48,cg_stat(st,24))
    putw(o,56,0)
    return 64+payload

def cg_read(s:readbuf,st:readbuf,o:mutbuf) -> u64:
    op = getr(s,8)
    at = cg_find(st,getr(s,16))
    if op == 4:
        putw(o,64,getr(st,at+32))
    if op == 5:
        copy_range(o,st,64,at+32,5056)
    if op == 18:
        copy_range(o,st,64,getr(s,32),getr(s,24))
    return cg_reply(o,st,0,cg_payload(s))

def cg_initialize(st:readbuf,trial:mutbuf,s:readbuf) -> u64:
    op = getr(s,8)
    size = length(st)
    if size == 0:
        putw(trial,0,STATE_MAGIC)
        putw(trial,8,0)
        putw(trial,16,0)
        putw(trial,24,0)
        putw(trial,32,1)
        putw(trial,40,5088)
        putw(trial,48,0)
        putw(trial,56,0)
    else:
        if op != 16:
            copy_range(trial,st,0,0,size)
        else:
            target = cg_find(st,getr(s,16))
            copy_range(trial,st,0,0,length(trial))
            last = size-5088
            if target != last:
                copy_range(trial,st,target,last,5088)
            putw(trial,16,cg_stat(st,16)-1)
    putw(trial,24,cg_stat(st,24)+1)
    return 0

def cg_apply(s:readbuf,st:readbuf,trial:mutbuf,scratch:mutbuf,o:mutbuf,e:readbuf) -> u64:
    op = getr(s,8)
    count = getr(s,24)
    a = getr(s,32)
    b = getr(s,40)
    at = cg_find(st,getr(s,16))
    if op == 6:
        if rng_restore(s,scratch,64) != 0:
            return 2
    cg_initialize(st,trial,s)
    if op == 16:
        return 0
    if op == 1 or op == 2 or op == 19:
        seed = a
        if op == 19:
            seed = 67280421310721
        rng_seed(scratch,seed)
    else:
        if op == 3:
            seed = getr(e,0)
            rng_seed(scratch,seed)
            putw(o,64,seed)
        else:
            if op != 6:
                copy_range(scratch,st,0,at+32,5056)
    if op == 1 or op == 7 or op == 19:
        live = cg_stat(st,16)
        last = cg_stat(st,8)
        i = 0
        while i < count:
            target = 64+(live+i)*5088
            handle = last+i+1
            putw(trial,target,handle)
            putw(trial,target+8,0)
            putw(trial,target+16,0)
            putw(trial,target+24,0)
            copy_from_mut(trial,scratch,target+32,0,5056)
            putw(o,64+i*8,handle)
            i = i+1
        putw(trial,8,last+count)
        putw(trial,16,live+count)
        return 0
    if op >= 8 and op <= 15:
        i = 0
        while i < count:
            value = 0
            if op == 8 or op == 9 or op == 11 or op == 13 or op == 14:
                value = rng_next(scratch)
            if op == 10 or op == 12:
                value = rng_next64(scratch)
            if op == 11 or op == 13 or op == 14:
                value = rng_unit32(value)
                if op == 13:
                    value = round_f16(value)
                    if value == 15360:
                        value = 0
                if op == 14:
                    value = round_bf16(value)
                    if value == 16256:
                        value = 0
            if op == 12:
                value = rng_unit64(value)
            if op == 15:
                span = b-a
                if span >= 268435456:
                    value = rng_next64(scratch)
                else:
                    value = rng_next(scratch)
                value = value % span+a
            if op != 8:
                putw(o,64+i*8,value)
            i = i+1
    copy_from_mut(trial,scratch,at+32,0,5056)
    return 0
