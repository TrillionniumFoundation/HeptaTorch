    {
      "id": "RNG-FLAT-001",
      "status": "FIXED_AND_NATIVE_RETESTED",
      "finding": "The retired entry wrote a 24-byte error into output capacities below24, trapping after partial in-capacity writes. New entry returns0 first; all seven short capacities leave output/workspace untouched. No out-of-capacity write was observed in either version."
    },
    {
      "id": "RNG-STATE-SCOPE",
      "status": "EXPLICIT_PROFILE_BOUNDARY",
      "finding": "Canonical/reachable MT positions and 0/1 cache flags are supported. Upstream is_valid only checks independent ranges; not all upstream-accepted states are accepted by this profile. Even safely refreshing left1,next1 is refused. No full set_state malformed-input parity is claimed.",
      "source": "aten/src/ATen/core/MT19937RNGEngine.h:130"
    },
    {
      "id": "RNG-STATE-LAYOUT",
      "status": "MATCHES_PINNED_SOURCE_AND_EXECUTION",
      "finding": "Full seed preserved; next and624 words truncate to32bits; seeded normalizes nonzero to1; dead legacy fields and padding clear; enabled float/double cache bit patterns preserve, disabled caches clear.",
      "source": "aten/src/ATen/CPUGeneratorImpl.cpp:17,135,177"
    },
    {
      "id": "RNG-CONSUMPTION",
      "status": "MATCHES_PINNED_SOURCE_AND_EXECUTION",
      "finding": "random64 combines high first then low; double rand consumes2 words and masks low53; float/half/bfloat consume1 and use low24 via float opmath. int64 ranges switch at2^28 for non-FBCODE builds, using modulo without rejection.",
      "source": "aten/src/ATen/CPUGeneratorImpl.cpp:235; aten/src/ATen/core/DistributionsHelper.h:37,99; aten/src/ATen/core/TransformationHelper.h:84"
    },
    {
      "id": "RNG-LOW-PRECISION-CLAMP",
      "status": "MATCHES_PINNED_SOURCE_AND_EXECUTION",
      "finding": "After float opmath conversion, a half/bfloat value equal to the exclusive upper bound1 is returned as0; exact halfway thresholds tested explicitly.",
      "source": "aten/src/ATen/native/cpu/DistributionTemplates.h:248"
    },
    {
      "id": "RNG-NOTICE",
      "status": "UPSTREAM_NOTICE_IDENTIFIED_FOR_INTEGRATION",
      "finding": "The MT engine header contains its own1997-2002 Matsumoto/Nishimura redistribution notice; root was notified to retain it with source attribution. This is distinct from the top-level PyTorch notice.",
