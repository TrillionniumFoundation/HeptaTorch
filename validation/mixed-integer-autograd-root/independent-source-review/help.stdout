usage: qualify_mixed_integer_autograd.py [-h] --repo REPO --parent-build
                                         PARENT_BUILD --upstream UPSTREAM
                                         --compiler COMPILER --linker LINKER
                                         --flat-compiler FLAT_COMPILER
                                         --stack-build STACK_BUILD --output
