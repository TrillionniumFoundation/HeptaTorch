{
  "schema": "heptatorch.mixed-tombstone-legacy-refusal-adaptation.v1",
  "original_test_sha256": "2dc6d1d6444264fec06c3429926adcf778e48b6b8b80226b690bc31667dcd6cc",
  "new_test_sha256": "55f308ac9c3e821dd4770f9f8eb42def43113c6f78e35f63a8f6dafcf72c968c",
  "legacy_refusal_sha256": "6ea9e8b33164089034a2a71a03f4850e1ec18ed1a09155d7841f700ef311c833",
  "edits": [
    {
      "label": "explicit-frozen-defective-predicate",
      "before": "import owner_accounting_mixed as observer\n",
      "after": "import owner_accounting_mixed as observer\n\n# Deliberately separate the historical defective predicate from the\n# current structural checker (aa8 already contains the correction).\nLEGACY_REFUSAL = HERE.parent / \"dtype_owner_accounting\" / \"owner640.py\"\nLEGACY_REFUSAL_SHA = \"6ea9e8b33164089034a2a71a03f4850e1ec18ed1a09155d7841f700ef311c833\"\n",
      "count": 1
    },
    {
      "label": "before-after-legacy-file-custody",
      "before": "\"protocol\": a.protocol, \"owner_client\": a.protocol.with_name(\"owner_client.py\")}",
      "after": "\"protocol\": a.protocol, \"owner_client\": a.protocol.with_name(\"owner_client.py\"),\n             \"legacy_refusal_owner640\": LEGACY_REFUSAL}",
      "count": 1
    },
    {
      "label": "load-only-SHA-verified-original6ea",
      "before": "        original = load(\"tombstone_original640\", observer.ORIGINAL_STRUCTURAL)\n",
      "after": "        assert inputs[\"legacy_refusal_owner640\"][\"sha256\"] == LEGACY_REFUSAL_SHA\n        original = load(\"tombstone_original640\", LEGACY_REFUSAL)\n        assert observer.sha(LEGACY_REFUSAL.read_bytes()) == LEGACY_REFUSAL_SHA\n",
      "count": 1
    },
    {
      "label": "explain-four-identity-bindings",
      "before": "        # file and every function body remain byte-identical; only these three\n",
      "after": "        # file and every function body remain byte-identical; only these four\n",
      "count": 1
    },
    {
      "label": "bind-schema-identity-without-changing-predicate",
      "before": "        original.SOURCE = observer.structural.SOURCE\n",
      "after": "        historical_identity = {name: getattr(original, name)\n                               for name in (\"SCHEMA\", \"SOURCE\", \"IMAGE\", \"PROFILE\")}\n        original.SCHEMA = observer.structural.SCHEMA\n        original.SOURCE = observer.structural.SOURCE\n",
      "count": 1
    },
    {
      "label": "record-original-and-current-data-identities",
      "before": "        report[\"original_predicate_profile_binding\"] = {\n            \"source_sha256\": original.SOURCE, \"native_sha256\": original.IMAGE,\n",
      "after": "        report[\"original_predicate_profile_binding\"] = {\n            \"predicate_file_sha256\": LEGACY_REFUSAL_SHA,\n            \"original_data_identity\": historical_identity,\n            \"changed_module_data_names\": [\"SCHEMA\", \"SOURCE\", \"IMAGE\", \"PROFILE\"],\n            \"schema\": original.SCHEMA,\n            \"source_sha256\": original.SOURCE, \"native_sha256\": original.IMAGE,\n",
      "count": 1
    },
    {
      "label": "preserve-primary-error-and-use-real-EOF-cleanup",
      "before": "        if session is not None and session.poll() is None:\n            session.stop()\n",
      "after": "        if session is not None and session.poll() is None:\n            try:\n                session.finish()\n            except BaseException as cleanup_error:\n                report[\"cleanup_error\"] = repr(cleanup_error)\n                report[\"cleanup_traceback\"] = traceback.format_exc()\n                if report[\"status\"] != \"FAIL\":\n                    report.update(status=\"FAIL\", error=repr(cleanup_error),\n                                  traceback=traceback.format_exc())\n",
      "count": 1
    }
  ],
  "inverse_entire_file_byte_identical": true,
  "all_original_assertion_AST_multiset_preserved": true,
